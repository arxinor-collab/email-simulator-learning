# 复制为 .env 后填写。服务端会读取 .env，前端不会接触这些值。
PORT=3000
HOST=127.0.0.1

# 贝贝的唯一收件地址。只允许这一地址，不能从浏览器改写。
BEIBEI_EMAIL=beibei@example.com

# SMTP 发信配置。全部填写后才会开启真实投递；缺少任一项时为教学演示模式。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 用于日志中的 IP 哈希。请改成随机长字符串，不要使用邮箱密码。
LOG_SALT=replace-with-a-random-long-value
